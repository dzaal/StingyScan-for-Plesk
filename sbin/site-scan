#!/usr/local/psa/admin/bin/php
<?php
/**
 * site-scan: scan one website's files with a malware scanner installed on the server.
 * Read-only: the scanners only report, nothing is deleted, moved or quarantined.
 *
 * Runs as root through pm_ApiCli::callSbin(), because website files belong to
 * the subscription users and the panel user cannot read them.
 *
 *   site-scan list                       JSON list of the scanners found on this server
 *   site-scan start <scanner> <hostname> start a scan in the background, print JSON
 *   site-scan --run <scanner> <hostname> (internal) the scan itself
 *
 * Each scanner is an adapter below: detect() says whether it is installed,
 * scan() runs it on a folder and returns one common result format:
 *   files, infected, found: [{file, signature}], errors
 * To support another scanner, add an adapter to SCANNERS.
 *
 * Only one engine is used: ClamAV when installed (it includes Maldet's signatures), else Maldet
 * when switched on in the settings. Maldet is refused here while ClamAV is installed.
 *
 * Only one scan runs at a time on the server; a scan started while another
 * one runs waits its turn ("queued").
 */

const DATA     = '/usr/local/psa/var/modules/stingyscan/data';
const VHOSTS   = '/var/www/vhosts/';
const MAX_LIST = 200;   // files listed in a result
const TIMEOUT  = 3600;  // seconds before a scan is stopped

// ── Adapters ───────────────────────────────────────────────────

/** Full path of a program, or '' (root's PATH can be short when called from Plesk) */
function bin_path(string $name): string
{
    $p = trim((string)shell_exec('export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; command -v ' . escapeshellarg($name) . ' 2>/dev/null'));
    return ($p !== '' && $p[0] === '/' && is_executable($p)) ? $p : '';
}

/** Does a clamd answer on this socket? */
function clamd_alive(string $sock): bool
{
    if (!file_exists($sock) || @filetype($sock) !== 'socket') return false;
    $c = @stream_socket_client('unix://' . $sock, $en, $es, 2);
    if (!$c) return false;
    stream_set_timeout($c, 2);
    fwrite($c, "zPING\0");
    $r = (string)fread($c, 16);
    fclose($c);
    return strpos($r, 'PONG') === 0;
}

/**
 * ClamAV: a running clamd (fast, signatures already loaded) through clamdscan, else clamscan.
 * Also reports version, whether the daemon runs, and whether Maldet's signatures are in ClamAV's database.
 */
function clamav_detect(): ?array
{
    $clamdscan = bin_path('clamdscan');
    $clamscan  = bin_path('clamscan');
    $confs = array_values(array_unique(array_merge(['/etc/clamd.d/scan.conf', '/etc/clamav/clamd.conf', '/etc/clamd.conf'], glob('/etc/clamd.d/*.conf') ?: [])));
    $daemonConf = ''; $anyConf = '';
    foreach ($confs as $c) {
        if (!is_file($c) || !preg_match('/^\s*LocalSocket\s+(\S+)/m', (string)@file_get_contents($c), $m)) continue;
        if ($anyConf === '') $anyConf = $c;
        if (clamd_alive($m[1])) { $daemonConf = $c; break; }
    }
    if (!$clamdscan && !$clamscan) return null;

    // Where ClamAV keeps its signatures; Maldet copies its rfxn.* files there
    $sigdir = '';
    foreach (array_filter([$daemonConf ?: $anyConf, '/etc/freshclam.conf', '/etc/clamav/freshclam.conf']) as $c) {
        if (preg_match('/^\s*DatabaseDirectory\s+(\S+)/m', (string)@file_get_contents($c), $m)) { $sigdir = rtrim($m[1], '/'); break; }
    }
    if ($sigdir === '' && is_dir('/var/lib/clamav')) $sigdir = '/var/lib/clamav';
    $rfxn = [];
    foreach (['rfxn.hdb', 'rfxn.ndb', 'rfxn.yara'] as $f) $rfxn[$f] = $sigdir !== '' && is_file("$sigdir/$f");

    // "ClamAV 1.4.6/28191/Sun Nov 22 07:27:13 2026" → "1.4.6, signatures 28191"
    $version = trim((string)shell_exec(escapeshellarg($clamscan ?: $clamdscan) . ' --version 2>/dev/null'));
    if (preg_match('#^ClamAV ([\d.]+)(?:/(\d+))?#', $version, $m)) $version = $m[1] . (isset($m[2]) ? ', signatures ' . $m[2] : '');

    $mode = ($daemonConf && $clamdscan) ? 'clamd' : ($clamscan ? 'clamscan' : 'none');
    return ['id' => 'clamav', 'name' => 'ClamAV', 'mode' => $mode, 'conf' => $daemonConf, 'clamdscan' => $clamdscan,
            'clamscan' => $clamscan, 'daemon' => (bool)$daemonConf, 'version' => $version, 'sigdir' => $sigdir, 'rfxn' => $rfxn];
}

function clamav_scan(array $s, string $root): array
{
    if ($s['mode'] === 'none') {
        return ['found' => [], 'errors' => 1, 'timeout' => false, 'files' => 0,
                'message' => 'clamd is not running and clamscan is not installed: start clamd or install clamscan'];
    }
    $cmd = $s['mode'] === 'clamd'
        ? escapeshellarg($s['clamdscan']) . ' -c ' . escapeshellarg($s['conf']) . ' --fdpass --infected --no-summary ' . escapeshellarg($root)
        : escapeshellarg($s['clamscan']) . ' -r --infected --no-summary ' . escapeshellarg($root);
    exec('timeout ' . TIMEOUT . ' nice -n 19 ionice -c3 ' . $cmd . ' 2>&1', $lines, $code);
    $found = []; $errors = 0;
    foreach ($lines as $line) {
        if (preg_match('/^(.*): (\S+) FOUND$/', $line, $m)) $found[] = ['file' => $m[1], 'signature' => $m[2]];
        elseif (stripos($line, 'ERROR') !== false || stripos($line, 'failed') !== false) $errors++;
    }
    $note = maldet_detect() && !in_array(false, $s['rfxn'] ?? [false], true)
        ? 'Scanned with ClamAV, including the Maldet signatures (rfxn.*) in its database.' : '';
    return ['found' => $found, 'errors' => $errors, 'timeout' => $code === 124, 'files' => count_files($root), 'note' => $note];
}

/** Linux Malware Detect (maldet), from rfxn.com. Only used when ClamAV is not installed. */
function maldet_detect(): ?array
{
    $bins = ['/usr/local/maldetect/maldet', '/usr/local/sbin/maldet'];
    if ($p = bin_path('maldet')) $bins[] = $p;
    foreach ($bins as $b) {
        if (!is_executable($b)) continue;
        $v = (string)shell_exec('timeout 10 ' . escapeshellarg($b) . ' --version 2>/dev/null');
        return ['id' => 'maldet', 'name' => 'Maldet', 'bin' => $b, 'version' => preg_match('/\bv(\d[\d.]*)/', $v, $m) ? $m[1] : ''];
    }
    return null;
}

function maldet_scan(array $s, string $root): array
{
    // Only the website folder: no /tmp etc., which maldet adds to every scan by default
    $cmd = 'timeout ' . TIMEOUT . ' ' . escapeshellarg($s['bin']) . ' -co scan_tmpdir_paths= -a ' . escapeshellarg($root) . ' 2>&1';
    exec($cmd, $lines, $code);
    $out   = implode("\n", $lines);
    $files = preg_match('/files (\d+), malware hits/', $out, $m) ? (int)$m[1] : count_files($root);
    $found = [];
    if (preg_match('/--report (\S+)/', $out, $m)) {
        $hits = '/usr/local/maldetect/sess/session.hits.' . basename($m[1]);
        foreach (@file($hits, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $line) {
            if (preg_match('/^(\S+)\s+:\s+(.+)$/', trim($line), $h)) $found[] = ['file' => $h[2], 'signature' => $h[1]];
        }
    }
    $failed = !preg_match('/scan completed on/', $out);
    return ['found' => $found, 'errors' => $failed ? 1 : 0, 'timeout' => $code === 124, 'files' => $files,
            'message' => $failed && $code !== 124 ? 'maldet did not complete the scan' : ''];
}

/**
 * ImunifyAV / Imunify360: read-only. No scan is started, because Imunify may be set
 * to clean up or quarantine what it finds (its own MALWARE_SCANNING.default_action).
 * Instead this shows the result of Imunify's own latest scan of the site.
 */
function imunify_detect(): ?array
{
    foreach (['/usr/bin/imunify-antivirus', '/usr/bin/imunify360-agent'] as $b) {
        if (is_executable($b)) return ['id' => 'imunify', 'name' => 'Imunify', 'bin' => $b, 'instant' => true];
    }
    return null;
}

function imunify_json(array $s, string $args): array
{
    $d = json_decode((string)shell_exec('timeout 120 ' . escapeshellarg($s['bin']) . ' ' . $args . ' --json 2>/dev/null'), true);
    return is_array($d) ? $d : [];
}

function imunify_scan(array $s, string $root): array
{
    // Latest Imunify scan of this folder or of the subscription that contains it
    $last = null;
    foreach (imunify_json($s, 'malware on-demand list --limit 100000')['items'] ?? [] as $it) {
        $path = rtrim((string)($it['path'] ?? ''), '/');
        if ($path === '' || strpos($root . '/', $path . '/') !== 0 || empty($it['completed'])) continue;
        if (!$last || $it['completed'] > $last['completed']) $last = $it;
    }
    $found = []; $active = 0;
    $labels = ['cleanup_done' => 'cleaned by Imunify', 'cleanup_removed' => 'removed by Imunify',
               'restored_from_backup' => 'restored from backup', 'cleanup_requires_myimunify_protection' => 'not cleaned'];
    foreach (imunify_json($s, 'malware malicious list --limit 1000 --search ' . escapeshellarg($root))['items'] ?? [] as $it) {
        $file = (string)($it['file'] ?? '');
        if (strpos($file, $root . '/') !== 0) continue;
        $st = (string)($it['status'] ?? '');
        $handled = strpos($st, 'cleanup_done') === 0 || strpos($st, 'cleanup_removed') === 0 || strpos($st, 'restored') === 0;
        if (!$handled) $active++;
        $found[] = ['file' => $file, 'signature' => (string)($it['type'] ?? '?') . ($st && $st !== 'found' ? ' (' . ($labels[$st] ?? $st) . ')' : ''),
                    'handled' => $handled];
    }
    usort($found, fn($a, $b) => $a['handled'] <=> $b['handled']);
    return [
        'found' => $found, 'infected' => $active, 'errors' => 0, 'timeout' => false,
        'files' => (int)($last['total_resources'] ?? 0),
        'scanned_at' => (int)($last['completed'] ?? 0),
        'note' => $last
            ? 'Result of Imunify\'s own ' . ($last['scan_type'] ?? '') . ' scan of ' . substr(rtrim($last['path'], '/'), strlen(VHOSTS)) . '. No new scan was started: Imunify handles found files with its own settings.'
            : 'Imunify has not scanned this site yet.',
    ];
}

const SCANNERS = ['clamav', 'maldet', 'imunify'];

// ── Helpers ────────────────────────────────────────────────────

function out(array $a): void { echo json_encode($a, JSON_UNESCAPED_SLASHES), "\n"; exit(0); }

function scanners(): array
{
    $list = [];
    foreach (SCANNERS as $id) {
        $s = ($id . '_detect')();
        if ($s) $list[$id] = $s;
    }
    return $list;
}

/** Short description of how a found scanner will be used */
function scanner_detail(array $s): string
{
    switch ($s['id']) {
        case 'clamav':  return $s['mode'] === 'clamd' ? 'running clamd (' . $s['conf'] . ')'
                             : ($s['mode'] === 'clamscan' ? 'clamscan (no clamd running)' : 'clamd not running, clamscan not installed');
        case 'maldet':  return $s['bin'];
        case 'imunify': return $s['bin'] . ', results only';
    }
    return '';
}

function count_files(string $root): int
{
    return (int)trim((string)shell_exec('find ' . escapeshellarg($root) . ' -type f 2>/dev/null | wc -l'));
}

function save(string $file, array $a): void
{
    file_put_contents($file . '.tmp', json_encode($a, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
    @chown($file . '.tmp', 'psaadm'); @chgrp($file . '.tmp', 'psaadm'); @chmod($file . '.tmp', 0640);
    rename($file . '.tmp', $file);
}

/** Document root of the site, from Plesk's database (parent domains for WordPress subsites) */
function docroot(string $host): ?string
{
    $name = $host;
    while (substr_count($name, '.') >= 1) {
        $sql  = "SELECT h.www_root FROM hosting h JOIN domains d ON d.id = h.dom_id "
              . "WHERE d.name = '" . $name . "' AND d.htype = 'vrt_hst' AND d.status = 0 LIMIT 1";
        $root = trim((string)shell_exec('plesk db -Ne ' . escapeshellarg($sql) . ' 2>/dev/null'));
        if ($root !== '') {
            $real = realpath($root);
            return ($real && strpos($real . '/', VHOSTS) === 0 && is_dir($real)) ? $real : null;
        }
        $name = substr($name, strpos($name, '.') + 1);
    }
    return null;
}

/** Run an adapter and build the common result */
function finish(array $base, string $id, array $scanner, string $root, int $started): array
{
    $r = ($id . '_scan')($scanner, $root);
    $found = [];
    foreach ($r['found'] as $f) {
        $file = (string)$f['file'];
        if (strpos($file, $root . '/') === 0) $file = substr($file, strlen($root) + 1);
        $found[] = ['file' => $file, 'signature' => (string)$f['signature']] + (isset($f['handled']) ? ['handled' => (bool)$f['handled']] : []);
    }
    $status = !empty($r['timeout']) ? 'timeout' : (!empty($r['message']) ? 'error' : 'done');
    return $base + [
        'status'   => $status,
        'started'  => $started,
        'finished' => $r['scanned_at'] ?? time(),
        'root'     => substr($root, strlen(VHOSTS)),
        'files'    => (int)$r['files'],
        'infected' => (int)($r['infected'] ?? count($found)),
        'found'    => array_slice($found, 0, MAX_LIST),
        'listed'   => count($found),
        'errors'   => (int)$r['errors'],
        'note'     => (string)($r['note'] ?? ''),
        'message'  => $status === 'timeout' ? 'Stopped after ' . (TIMEOUT / 60) . ' minutes' : (string)($r['message'] ?? ''),
    ];
}

// ── Main ───────────────────────────────────────────────────────

$mode = $argv[1] ?? '';
if ($mode === 'list') {
    // Every known scanner, installed or not, so the settings can show what was found
    $names = ['clamav' => 'ClamAV', 'maldet' => 'Maldet', 'imunify' => 'Imunify'];
    $found = scanners();
    $list  = [];
    foreach (SCANNERS as $id) {
        $s = $found[$id] ?? null;
        $list[] = ['id' => $id, 'name' => $s['name'] ?? $names[$id], 'installed' => (bool)$s,
                   'instant' => !empty($s['instant']), 'detail' => $s ? scanner_detail($s) : ''];
    }
    // Scan engines for the settings page (see VtScanEngine: only one of them is ever used)
    $engines = [];
    foreach (['clamav', 'maldet'] as $id) {
        $s = $found[$id] ?? null;
        $engines[$id] = $s ? ['installed' => true] + array_diff_key($s, ['id' => 1, 'name' => 1]) : ['installed' => false];
    }
    out(['scanners' => $list, 'engines' => $engines]);
}
if ($mode === 'wpconfigs') {
    // Which database and table prefix every WordPress install on the server uses (read-only)
    $list = [];
    $paths = explode("\n", trim((string)shell_exec('find ' . VHOSTS . ' -maxdepth 5 -name wp-config.php -type f -not -path "' . VHOSTS . 'system/*" 2>/dev/null')));
    foreach ($paths as $p) {
        if ($p === '' || is_link($p)) continue;
        $c = (string)@file_get_contents($p, false, null, 0, 65536);
        if (!preg_match("/define\\(\\s*['\"]DB_NAME['\"]\\s*,\\s*['\"]([^'\"]+)['\"]/", $c, $db)) continue;
        $prefix = preg_match("/\\\$table_prefix\\s*=\\s*['\"]([^'\"]*)['\"]/", $c, $m) ? $m[1] : 'wp_';
        $list[] = ['path' => substr($p, strlen(VHOSTS)), 'db' => $db[1], 'prefix' => $prefix];
    }
    out(['configs' => $list]);
}
if ($mode === 'dump') {
    // Back up a database (or only the tables with one prefix) to the subscription's private folder.
    // Nothing is deleted: this is the safety copy before the admin deletes it in Plesk.
    $db     = (string)($argv[2] ?? '');
    $prefix = (string)($argv[3] ?? '');
    $host   = strtolower((string)($argv[4] ?? ''));
    if ($prefix === '-') $prefix = '';
    if (!preg_match('/^[A-Za-z0-9_\-]{1,64}$/', $db) || !preg_match('/^[A-Za-z0-9_]{0,32}$/', $prefix)
        || ($host !== '' && !preg_match('/^[a-z0-9][a-z0-9.\-]*\.[a-z0-9\-]{2,}$/', $host))) out(['error' => 'Invalid database, prefix or hostname']);
    $q   = fn(string $sql) => trim((string)shell_exec('plesk db -Ne ' . escapeshellarg($sql) . ' 2>/dev/null'));
    putenv('MYSQL_PWD=' . trim((string)@file_get_contents('/etc/psa/.psa.shadow')));
    if (trim((string)shell_exec('mysql -uadmin -N -e ' . escapeshellarg("SHOW DATABASES LIKE '" . str_replace('_', '\\_', $db) . "'") . ' 2>/dev/null')) !== $db) {
        out(['error' => 'Database ' . $db . ' does not exist on the local database server']);
    }
    $row = $q("SELECT COALESCE(NULLIF(d.webspace_id,0), d.id), s.host FROM data_bases b JOIN domains d ON d.id = b.dom_id "
            . "JOIN DatabaseServers s ON s.id = b.db_server_id WHERE b.name = '" . $db . "' AND b.type = 'mysql' LIMIT 1");
    if ($row !== '') {
        [$webspace, $dbhost] = array_pad(preg_split('/\s+/', $row), 2, '');
        if (!in_array($dbhost, ['localhost', '127.0.0.1', '::1', ''], true)) out(['error' => 'Only databases on the local database server can be backed up from here']);
    } else {
        // Not registered in Plesk (created by hand or left over): store the backup with the
        // hosted domain the hostname falls under
        $webspace = '';
        for ($name = $host; $name !== '' && substr_count($name, '.') >= 1; $name = substr($name, strpos($name, '.') + 1)) {
            $webspace = $q("SELECT COALESCE(NULLIF(webspace_id,0), id) FROM domains WHERE name = '" . $name . "' AND htype = 'vrt_hst' LIMIT 1");
            if ($webspace !== '') break;
        }
        if ($webspace === '') out(['error' => 'Could not find the subscription this database belongs to']);
    }
    $user = preg_split('/\s+/', $q("SELECT s.login, s.home FROM hosting h JOIN sys_users s ON s.id = h.sys_user_id WHERE h.dom_id = " . (int)$webspace . " LIMIT 1"));
    [$login, $home] = array_pad($user, 2, '');
    if (!$login || strpos(rtrim($home, '/') . '/', VHOSTS) !== 0 || !is_dir($home)) out(['error' => 'Could not find the subscription folder']);

    putenv('MYSQL_PWD=' . trim((string)@file_get_contents('/etc/psa/.psa.shadow')));
    $tables = [];
    if ($prefix !== '') {
        foreach (explode("\n", trim((string)shell_exec('mysql -uadmin -N -e ' . escapeshellarg('SHOW TABLES FROM `' . $db . '`') . ' 2>/dev/null'))) as $t) {
            if ($t !== '' && strpos($t, $prefix) === 0) $tables[] = $t;
        }
        if (!$tables) out(['error' => 'No tables with prefix ' . $prefix . ' in ' . $db]);
    }
    $private = rtrim($home, '/') . '/private';
    if (!is_dir($private) || is_link($private)) out(['error' => 'The subscription has no private folder']);
    $dir = $private . '/vt-db-backups';
    if (is_link($dir)) out(['error' => 'Unexpected link in the private folder']);
    if (!is_dir($dir)) mkdir($dir, 0700);
    chown($dir, $login); chgrp($dir, 'psacln'); chmod($dir, 0700); // never leave anything root-owned in a vhost
    $file = $dir . '/' . $db . ($prefix !== '' ? '-' . rtrim($prefix, '_') : '') . '-' . date('Ymd-His') . '.sql.gz';
    $cmd  = 'mysqldump -uadmin --single-transaction --quick --no-tablespaces ' . escapeshellarg($db) . ' '
          . implode(' ', array_map('escapeshellarg', $tables)) . ' 2>/dev/null | gzip -9 > ' . escapeshellarg($file)
          . '; echo ${PIPESTATUS[0]}';
    $code = trim((string)shell_exec('bash -c ' . escapeshellarg($cmd)));
    putenv('MYSQL_PWD');
    if (is_file($file)) { chown($file, $login); chgrp($file, 'psacln'); chmod($file, 0600); }
    if ($code !== '0' || !is_file($file) || filesize($file) < 100) { @unlink($file); out(['error' => 'The backup failed']); }
    out(['ok' => true, 'file' => substr($file, strlen(VHOSTS)), 'size' => filesize($file), 'tables' => count($tables)]);
}
if ($mode !== 'start' && $mode !== '--run') out(['error' => 'usage: site-scan list | wpconfigs | dump <db> [prefix] | start <scanner> <hostname>']);

$id   = (string)($argv[2] ?? '');
$host = strtolower(trim((string)($argv[3] ?? '')));
if (!in_array($id, SCANNERS, true)) out(['error' => 'Unknown scanner']);
if (!preg_match('/^[a-z0-9][a-z0-9.\-]*\.[a-z0-9\-]{2,}$/', $host)) out(['error' => 'Invalid site name']);
$all     = scanners();
$scanner = $all[$id] ?? null;
if (!$scanner) out(['error' => $id . ' is not installed on this server']);

$resultFile = DATA . '/vt_scan_' . $id . '_' . preg_replace('/[^a-z0-9]/', '_', $host) . '.json';
$lockFile   = DATA . '/vt_scan.lock';
$base       = ['domain' => $host, 'scanner' => $id, 'name' => $scanner['name']];

// One scan engine only: with ClamAV installed, Maldet never runs (ClamAV already uses Maldet's signatures)
if ($id === 'maldet' && isset($all['clamav'])) {
    $msg = 'Maldet is not used while ClamAV is installed: the ClamAV scan includes the Maldet signatures';
    if ($mode === '--run') { save($resultFile, $base + ['status' => 'error', 'finished' => time(), 'message' => $msg]); exit(0); }
    out(['error' => $msg]);
}

if ($mode === 'start') {
    $prev = json_decode((string)@file_get_contents($resultFile), true);
    if (in_array($prev['status'] ?? '', ['running', 'queued'], true) && time() - (int)($prev['started'] ?? 0) < TIMEOUT + 600) {
        out(['started' => true, 'already' => true] + $base);
    }
    $root = docroot($host);
    if (!$root) out(['error' => 'Could not find the website folder of ' . $host]);

    $lock = fopen($lockFile, 'c');
    $free = $lock && flock($lock, LOCK_EX | LOCK_NB);
    if ($free) flock($lock, LOCK_UN);
    if ($lock) fclose($lock);
    save($resultFile, $base + ['status' => $free ? 'running' : 'queued', 'started' => time(), 'root' => substr($root, strlen(VHOSTS))]);
    exec('setsid nohup ' . escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg(__FILE__)
         . ' --run ' . escapeshellarg($id) . ' ' . escapeshellarg($host) . ' >/dev/null 2>&1 &');
    out(['started' => true] + $base);
}

// --run: wait for any other scan to finish (one at a time on the server)
$lock = fopen($lockFile, 'c');
if (!$lock || !flock($lock, LOCK_EX)) {
    save($resultFile, $base + ['status' => 'error', 'finished' => time(), 'message' => 'Could not start the scan']);
    exit(0);
}
ftruncate($lock, 0); fwrite($lock, "$id $host"); fflush($lock);

// Rate limit actual work, including read-only Imunify result requests, across all users.
require_once '/usr/local/psa/admin/plib/modules/stingyscan/library/VtCheckRateLimiter.php';
try {
    while ($wait = VtCheckRateLimiter::reserve($id)) {
        save($resultFile, $base + ['status' => 'queued', 'started' => time(), 'message' => 'Waiting for request rate limit']);
        sleep($wait);
    }
} catch (\Throwable $e) {
    save($resultFile, $base + ['status' => 'error', 'finished' => time(), 'message' => 'Request rate limiter unavailable']);
    exit(1);
}

$started = time();
$root    = docroot($host);
if (!$root) {
    save($resultFile, $base + ['status' => 'error', 'finished' => time(), 'message' => 'Website folder not found']);
    exit(0);
}
save($resultFile, $base + ['status' => 'running', 'started' => $started, 'root' => substr($root, strlen(VHOSTS))]);

save($resultFile, finish($base, $id, $scanner, $root, $started));
ftruncate($lock, 0);
flock($lock, LOCK_UN);
