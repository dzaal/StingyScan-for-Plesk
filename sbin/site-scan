#!/usr/local/psa/admin/bin/php
<?php
/**
 * site-scan: scan one website's files with a malware scanner installed on the server.
 * Read-only: the scanners only report, nothing is deleted, moved or quarantined.
 *
 * Runs as root through pm_ApiCli::callSbin(), because website files belong to
 * the subscription users and the panel user cannot read them.
 *
 *   site-scan list                       JSON list of the scanners found on this server
 *   site-scan start <scanner> <hostname> start a scan in the background, print JSON
 *   site-scan --run <scanner> <hostname> (internal) the scan itself
 *
 * Each scanner is an adapter below: detect() says whether it is installed,
 * scan() runs it on a folder and returns one common result format:
 *   files, infected, found: [{file, signature}], errors
 * To support another scanner, add an adapter to SCANNERS.
 *
 * Only one engine is used: ClamAV when installed (it includes Maldet's signatures), else Maldet
 * when switched on in the settings. Maldet is refused here while ClamAV is installed.
 *
 * Only one scan runs at a time on the server; a scan started while another
 * one runs waits its turn ("queued").
 */

const DATA     = '/usr/local/psa/var/modules/stingyscan/data';
const VHOSTS   = '/var/www/vhosts/';
const MAX_LIST = 200;   // files listed in a result
const TIMEOUT  = 3600;  // seconds before a scan is stopped

// ── Adapters ───────────────────────────────────────────────────

/** Full path of a program, or '' (root's PATH can be short when called from Plesk) */
function bin_path(string $name): string
{
    $p = trim((string)shell_exec('export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; command -v ' . escapeshellarg($name) . ' 2>/dev/null'));
    return ($p !== '' && $p[0] === '/' && is_executable($p)) ? $p : '';
}

/** Does a clamd answer on this socket? */
function clamd_alive(string $sock): bool
{
    if (!file_exists($sock) || @filetype($sock) !== 'socket') return false;
    $c = @stream_socket_client('unix://' . $sock, $en, $es, 2);
    if (!$c) return false;
    stream_set_timeout($c, 2);
    fwrite($c, "zPING\0");
    $r = (string)fread($c, 16);
    fclose($c);
    return strpos($r, 'PONG') === 0;
}

/**
 * ClamAV: a running clamd (fast, signatures already loaded) through clamdscan, else clamscan.
 * Also reports version, whether the daemon runs, and whether Maldet's signatures are in ClamAV's database.
 */
function clamav_detect(): ?array
{
    $clamdscan = bin_path('clamdscan');
    $clamscan  = bin_path('clamscan');
    $confs = array_values(array_unique(array_merge(['/etc/clamd.d/scan.conf', '/etc/clamav/clamd.conf', '/etc/clamd.conf'], glob('/etc/clamd.d/*.conf') ?: [])));
    $daemonConf = ''; $anyConf = '';
    foreach ($confs as $c) {
        if (!is_file($c) || !preg_match('/^\s*LocalSocket\s+(\S+)/m', (string)@file_get_contents($c), $m)) continue;
        if ($anyConf === '') $anyConf = $c;
        if (clamd_alive($m[1])) { $daemonConf = $c; break; }
    }
    if (!$clamdscan && !$clamscan) return null;

    // Where ClamAV keeps its signatures; Maldet copies its rfxn.* files there
    $sigdir = '';
    foreach (array_filter([$daemonConf ?: $anyConf, '/etc/freshclam.conf', '/etc/clamav/freshclam.conf']) as $c) {
        if (preg_match('/^\s*DatabaseDirectory\s+(\S+)/m', (string)@file_get_contents($c), $m)) { $sigdir = rtrim($m[1], '/'); break; }
    }
    if ($sigdir === '' && is_dir('/var/lib/clamav')) $sigdir = '/var/lib/clamav';
    $rfxn = [];
    foreach (['rfxn.hdb', 'rfxn.ndb', 'rfxn.yara'] as $f) $rfxn[$f] = $sigdir !== '' && is_file("$sigdir/$f");

    // "ClamAV 1.4.6/28191/Sun Nov 22 07:27:13 2026" → "1.4.6, signatures 28191"
    $version = trim((string)shell_exec(escapeshellarg($clamscan ?: $clamdscan) . ' --version 2>/dev/null'));
    if (preg_match('#^ClamAV ([\d.]+)(?:/(\d+))?#', $version, $m)) $version = $m[1] . (isset($m[2]) ? ', signatures ' . $m[2] : '');

    $mode = ($daemonConf && $clamdscan) ? 'clamd' : ($clamscan ? 'clamscan' : 'none');
    return ['id' => 'clamav', 'name' => 'ClamAV', 'mode' => $mode, 'conf' => $daemonConf, 'clamdscan' => $clamdscan,
            'clamscan' => $clamscan, 'daemon' => (bool)$daemonConf, 'version' => $version, 'sigdir' => $sigdir, 'rfxn' => $rfxn];
}

/** Report progress of a running scan: done of total files (set by --run, throttled there) */
function progress(int $done, int $total, string $phase = ''): void
{
    if (isset($GLOBALS['on_progress'])) ($GLOBALS['on_progress'])($done, $total, $phase);
}

function clamav_scan(array $s, string $root): array
{
    if ($s['mode'] === 'none') {
        return ['found' => [], 'errors' => 1, 'timeout' => false, 'files' => 0,
                'message' => 'clamd is not running and clamscan is not installed: start clamd or install clamscan'];
    }
    // Scan from a list of the site's files: then ClamAV reports every file, which gives the real progress
    // (a folder scan only reports the infected ones). Same speed as a folder scan.
    $paths = array_values(array_filter(explode("\0", (string)shell_exec('find ' . escapeshellarg($root) . ' -type f -print0 2>/dev/null')),
                                       fn($f) => $f !== '' && strpos($f, "\n") === false));
    $total = count($paths);
    $list  = tempnam(sys_get_temp_dir(), 'sst');
    chmod($list, 0600);
    file_put_contents($list, implode("\n", $paths) . "\n");
    unset($paths);
    progress(0, $total);
    $cmd = $s['mode'] === 'clamd'
        ? escapeshellarg($s['clamdscan']) . ' -c ' . escapeshellarg($s['conf']) . ' --fdpass --no-summary --file-list=' . escapeshellarg($list)
        : escapeshellarg($s['clamscan']) . ' --no-summary --file-list=' . escapeshellarg($list);
    $proc = proc_open('exec timeout ' . TIMEOUT . ' nice -n 19 ionice -c3 ' . $cmd . ' 2>&1', [1 => ['pipe', 'w']], $pipes);
    $found = []; $errors = 0; $done = 0;
    while ($proc && ($line = fgets($pipes[1])) !== false) {
        $line = rtrim($line, "\n");
        if (substr($line, -4) === ': OK') $done++;
        elseif (preg_match('/^(.*): (\S+) FOUND$/', $line, $m)) { $found[] = ['file' => $m[1], 'signature' => $m[2]]; $done++; }
        elseif (stripos($line, 'ERROR') !== false || stripos($line, 'failed') !== false) { $errors++; $done++; }
        progress($done, $total);
    }
    if ($proc) fclose($pipes[1]);
    $code = $proc ? proc_close($proc) : 1;
    @unlink($list);
    $note = maldet_detect() && !in_array(false, $s['rfxn'] ?? [false], true)
        ? 'Scanned with ClamAV, including the Maldet signatures (rfxn.*) in its database.' : '';
    return ['found' => $found, 'errors' => $errors, 'timeout' => $code === 124, 'files' => $total, 'note' => $note];
}

/** Linux Malware Detect (maldet), from rfxn.com. Only used when ClamAV is not installed. */
function maldet_detect(): ?array
{
    $bins = ['/usr/local/maldetect/maldet', '/usr/local/sbin/maldet'];
    if ($p = bin_path('maldet')) $bins[] = $p;
    foreach ($bins as $b) {
        if (!is_executable($b)) continue;
        $v = (string)shell_exec('timeout 10 ' . escapeshellarg($b) . ' --version 2>/dev/null');
        return ['id' => 'maldet', 'name' => 'Maldet', 'bin' => $b, 'version' => preg_match('/\bv(\d[\d.]*)/', $v, $m) ? $m[1] : ''];
    }
    return null;
}

function maldet_scan(array $s, string $root): array
{
    // Only the website folder: no /tmp etc., which maldet adds to every scan by default
    $cmd = 'timeout ' . TIMEOUT . ' ' . escapeshellarg($s['bin']) . ' -co scan_tmpdir_paths= -a ' . escapeshellarg($root) . ' 2>&1';
    exec($cmd, $lines, $code);
    $out   = implode("\n", $lines);
    $files = preg_match('/files (\d+), malware hits/', $out, $m) ? (int)$m[1] : count_files($root);
    $found = [];
    if (preg_match('/--report (\S+)/', $out, $m)) {
        $hits = '/usr/local/maldetect/sess/session.hits.' . basename($m[1]);
        foreach (@file($hits, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $line) {
            if (preg_match('/^(\S+)\s+:\s+(.+)$/', trim($line), $h)) $found[] = ['file' => $h[2], 'signature' => $h[1]];
        }
    }
    $failed = !preg_match('/scan completed on/', $out);
    return ['found' => $found, 'errors' => $failed ? 1 : 0, 'timeout' => $code === 124, 'files' => $files,
            'message' => $failed && $code !== 124 ? 'maldet did not complete the scan' : ''];
}

/**
 * ImunifyAV / Imunify360: read-only. No scan is started, because Imunify may be set
 * to clean up or quarantine what it finds (its own MALWARE_SCANNING.default_action).
 * Instead this shows the result of Imunify's own latest scan of the site.
 */
function imunify_detect(): ?array
{
    foreach (['/usr/bin/imunify-antivirus', '/usr/bin/imunify360-agent'] as $b) {
        if (is_executable($b)) return ['id' => 'imunify', 'name' => 'Imunify', 'bin' => $b, 'instant' => true];
    }
    return null;
}

function imunify_json(array $s, string $args): array
{
    $d = json_decode((string)shell_exec('timeout 120 ' . escapeshellarg($s['bin']) . ' ' . $args . ' --json 2>/dev/null'), true);
    return is_array($d) ? $d : [];
}

function imunify_scan(array $s, string $root): array
{
    // Is Imunify scanning this site (or a folder around or inside it) right now? Then wait for it,
    // showing Imunify's own progress, and read the results when it is done.
    for ($t = 0; $t < TIMEOUT; $t += 3) {
        $st = imunify_json($s, 'malware on-demand status')['items'] ?? [];
        $p  = rtrim((string)($st['path'] ?? ''), '/');
        if (($st['status'] ?? '') !== 'running' || $p === ''
            || (strpos($root . '/', $p . '/') !== 0 && strpos($p . '/', $root . '/') !== 0)) break;
        progress((int)($st['progress'] ?? 0), 100, 'Imunify: ' . (string)($st['phase'] ?? 'scanning'));
        sleep(3);
    }
    // Latest Imunify scan of this folder or of the subscription that contains it
    $last = null;
    foreach (imunify_json($s, 'malware on-demand list --limit 100000')['items'] ?? [] as $it) {
        $path = rtrim((string)($it['path'] ?? ''), '/');
        if ($path === '' || strpos($root . '/', $path . '/') !== 0 || empty($it['completed'])) continue;
        if (!$last || $it['completed'] > $last['completed']) $last = $it;
    }
    $found = []; $active = 0;
    $labels = ['cleanup_done' => 'cleaned by Imunify', 'cleanup_removed' => 'removed by Imunify',
               'restored_from_backup' => 'restored from backup', 'cleanup_requires_myimunify_protection' => 'not cleaned'];
    foreach (imunify_json($s, 'malware malicious list --limit 1000 --search ' . escapeshellarg($root))['items'] ?? [] as $it) {
        $file = (string)($it['file'] ?? '');
        if (strpos($file, $root . '/') !== 0) continue;
        if (!file_exists($file) && !is_link($file)) continue; // no longer there (quarantined or deleted): not infected any more
        $st = (string)($it['status'] ?? '');
        $handled = strpos($st, 'cleanup_done') === 0 || strpos($st, 'cleanup_removed') === 0 || strpos($st, 'restored') === 0;
        if (!$handled) $active++;
        $found[] = ['file' => $file, 'signature' => (string)($it['type'] ?? '?') . ($st && $st !== 'found' ? ' (' . ($labels[$st] ?? $st) . ')' : ''),
                    'handled' => $handled];
    }
    usort($found, fn($a, $b) => $a['handled'] <=> $b['handled']);
    return [
        'found' => $found, 'infected' => $active, 'errors' => 0, 'timeout' => false,
        'files' => (int)($last['total_resources'] ?? 0),
        'scanned_at' => (int)($last['completed'] ?? 0),
        'note' => $last
            ? 'Result of Imunify\'s own ' . ($last['scan_type'] ?? '') . ' scan of ' . substr(rtrim($last['path'], '/'), strlen(VHOSTS)) . '. No new scan was started: Imunify handles found files with its own settings.'
            : 'Imunify has not scanned this site yet.',
    ];
}

const SCANNERS = ['clamav', 'maldet', 'imunify'];

// ── Helpers ────────────────────────────────────────────────────

function out(array $a): void { echo json_encode($a, JSON_UNESCAPED_SLASHES), "\n"; exit(0); }

function scanners(): array
{
    $list = [];
    foreach (SCANNERS as $id) {
        $s = ($id . '_detect')();
        if ($s) $list[$id] = $s;
    }
    return $list;
}

/** Short description of how a found scanner will be used */
function scanner_detail(array $s): string
{
    switch ($s['id']) {
        case 'clamav':  return $s['mode'] === 'clamd' ? 'running clamd (' . $s['conf'] . ')'
                             : ($s['mode'] === 'clamscan' ? 'clamscan (no clamd running)' : 'clamd not running, clamscan not installed');
        case 'maldet':  return $s['bin'];
        case 'imunify': return $s['bin'] . ', results only';
    }
    return '';
}

function count_files(string $root): int
{
    return (int)trim((string)shell_exec('find ' . escapeshellarg($root) . ' -type f 2>/dev/null | wc -l'));
}

function save(string $file, array $a): void
{
    file_put_contents($file . '.tmp', json_encode($a, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
    @chown($file . '.tmp', 'psaadm'); @chgrp($file . '.tmp', 'psaadm'); @chmod($file . '.tmp', 0640);
    rename($file . '.tmp', $file);
}

/** Document root of the site, from Plesk's database (parent domains for WordPress subsites) */
function docroot(string $host): ?string
{
    $name = $host;
    while (substr_count($name, '.') >= 1) {
        $sql  = "SELECT h.www_root FROM hosting h JOIN domains d ON d.id = h.dom_id "
              . "WHERE d.name = '" . $name . "' AND d.htype = 'vrt_hst' AND d.status = 0 LIMIT 1";
        $root = trim((string)shell_exec('plesk db -Ne ' . escapeshellarg($sql) . ' 2>/dev/null'));
        if ($root !== '') {
            $real = realpath($root);
            return ($real && strpos($real . '/', VHOSTS) === 0 && is_dir($real)) ? $real : null;
        }
        $name = substr($name, strpos($name, '.') + 1);
    }
    return null;
}

/** Run an adapter and build the common result */
function finish(array $base, string $id, array $scanner, string $root, int $started): array
{
    $r = ($id . '_scan')($scanner, $root);
    $found = [];
    foreach ($r['found'] as $f) {
        $file = (string)$f['file'];
        if (strpos($file, $root . '/') === 0) $file = substr($file, strlen($root) + 1);
        $found[] = ['file' => $file, 'signature' => (string)$f['signature']] + (isset($f['handled']) ? ['handled' => (bool)$f['handled']] : []);
    }
    $status = !empty($r['timeout']) ? 'timeout' : (!empty($r['message']) ? 'error' : 'done');
    return $base + [
        'status'   => $status,
        'started'  => $started,
        'finished' => $r['scanned_at'] ?? time(),
        'root'     => substr($root, strlen(VHOSTS)),
        'files'    => (int)$r['files'],
        'infected' => (int)($r['infected'] ?? count($found)),
        'found'    => array_slice($found, 0, MAX_LIST),
        'listed'   => count($found),
        'errors'   => (int)$r['errors'],
        'note'     => (string)($r['note'] ?? ''),
        'message'  => $status === 'timeout' ? 'Stopped after ' . (TIMEOUT / 60) . ' minutes' : (string)($r['message'] ?? ''),
    ];
}

// ── Main ───────────────────────────────────────────────────────

$mode = $argv[1] ?? '';
if ($mode === 'list') {
    // Every known scanner, installed or not, so the settings can show what was found
    $names = ['clamav' => 'ClamAV', 'maldet' => 'Maldet', 'imunify' => 'Imunify'];
    $found = scanners();
    $list  = [];
    foreach (SCANNERS as $id) {
        $s = $found[$id] ?? null;
        $row = ['id' => $id, 'name' => $s['name'] ?? $names[$id], 'installed' => (bool)$s,
                'instant' => !empty($s['instant']), 'detail' => $s ? scanner_detail($s) : ''];
        if ($id === 'imunify' && $s) {
            // Cleaning needs ImunifyAV+ or Imunify360; the free ImunifyAV only detects
            $lic = (string)(imunify_json($s, 'malware malicious summary')['license']['license_type'] ?? '');
            $row['license'] = $lic;
            $row['cleanup'] = $lic !== '' && strcasecmp($lic, 'imunifyAV') !== 0;
            $row['detail'] .= $lic !== '' ? ' (' . $lic . ($row['cleanup'] ? ', can clean' : ', detection only') . ')' : '';
        }
        $list[] = $row;
    }
    // Scan engines for the settings page (see VtScanEngine: only one of them is ever used)
    $engines = [];
    foreach (['clamav', 'maldet'] as $id) {
        $s = $found[$id] ?? null;
        $engines[$id] = $s ? ['installed' => true] + array_diff_key($s, ['id' => 1, 'name' => 1]) : ['installed' => false];
    }
    out(['scanners' => $list, 'engines' => $engines]);
}
if ($mode === 'wpreset') {
    // Pwned? fix: give one WordPress administrator an unknown random password and log them out everywhere.
    // wpreset <path of wp-config.php under VHOSTS> <user id> <e-mail address the account must have>
    // WP-CLI runs as the owner of wp-config.php (never as root inside the site); the new password is never shown or stored.
    $rel   = (string)($argv[2] ?? '');
    $uid   = (string)($argv[3] ?? '');
    $email = strtolower(trim((string)($argv[4] ?? '')));
    if ($rel === '' || strpos($rel, '..') !== false || $rel[0] === '/' || basename($rel) !== 'wp-config.php'
        || !preg_match('/^[1-9][0-9]{0,9}$/', $uid) || !filter_var($email, FILTER_VALIDATE_EMAIL)) out(['error' => 'Invalid parameters']);
    $cfg = realpath(VHOSTS . $rel);
    if (!$cfg || strpos($cfg, VHOSTS) !== 0 || strpos($cfg, VHOSTS . 'system/') === 0 || is_link(VHOSTS . $rel)) out(['error' => 'wp-config.php not found']);
    $owner = posix_getpwuid(fileowner($cfg))['name'] ?? '';
    if ($owner === '' || $owner === 'root') out(['error' => 'wp-config.php is owned by root; not resetting as root']);
    $wp  = bin_path('wp') ?: (is_file('/usr/local/bin/wp') ? '/usr/local/bin/wp' : '');
    if ($wp === '') out(['error' => 'WP-CLI is not installed on this server (https://wp-cli.org)']);
    $php = '';
    foreach (glob('/opt/plesk/php/*/bin/php') ?: [] as $p) if (is_executable($p)) $php = $p; // newest Plesk PHP (glob is sorted)
    if ($php === '') $php = bin_path('php');
    $dir = dirname($cfg);
    if (!is_file($dir . '/wp-load.php')) {
        // wp-config.php one level above the install
        foreach (glob($dir . '/*/wp-load.php') ?: [] as $l) { $dir = dirname($l); break; }
    }
    $run = function (string $args) use ($owner, $php, $wp, $dir): array {
        $cmd = 'runuser -u ' . escapeshellarg($owner) . ' -- ' . escapeshellarg($php) . ' -d memory_limit=512M ' . escapeshellarg($wp)
             . ' --path=' . escapeshellarg($dir) . ' --skip-plugins --skip-themes --quiet ' . $args . ' 2>&1';
        exec($cmd, $o, $rc);
        return [$rc, trim(implode("\n", $o))];
    };
    [$rc, $got] = $run('user get ' . $uid . ' --field=user_email');
    if ($rc !== 0) out(['error' => 'WP-CLI could not read the user: ' . substr($got, 0, 300)]);
    if (strtolower(trim($got)) !== $email) out(['error' => 'This account no longer has that e-mail address']);
    [$rc, $msg] = $run('user update ' . $uid . ' --user_pass=' . escapeshellarg(bin2hex(random_bytes(24))) . ' --skip-email');
    if ($rc !== 0) out(['error' => 'Could not set a new password: ' . substr($msg, 0, 300)]);
    [$rc2, $msg2] = $run('user session destroy ' . $uid . ' --all');
    out(['ok' => true, 'logged_out' => $rc2 === 0] + ($rc2 !== 0 ? ['note' => 'Sessions not cleared: ' . substr($msg2, 0, 200)] : []));
}
if ($mode === 'wpconfigs') {
    // Which database and table prefix every WordPress install on the server uses (read-only)
    $list = [];
    $paths = explode("\n", trim((string)shell_exec('find ' . VHOSTS . ' -maxdepth 5 -name wp-config.php -type f -not -path "' . VHOSTS . 'system/*" 2>/dev/null')));
    foreach ($paths as $p) {
        if ($p === '' || is_link($p)) continue;
        $c = (string)@file_get_contents($p, false, null, 0, 65536);
        if (!preg_match("/define\\(\\s*['\"]DB_NAME['\"]\\s*,\\s*['\"]([^'\"]+)['\"]/", $c, $db)) continue;
        $prefix = preg_match("/\\\$table_prefix\\s*=\\s*['\"]([^'\"]*)['\"]/", $c, $m) ? $m[1] : 'wp_';
        $list[] = ['path' => substr($p, strlen(VHOSTS)), 'db' => $db[1], 'prefix' => $prefix];
    }
    out(['configs' => $list]);
}
if ($mode === 'dump') {
    // Back up a database (or only the tables with one prefix) to the subscription's private folder.
    // Nothing is deleted: this is the safety copy before the admin deletes it in Plesk.
    $db     = (string)($argv[2] ?? '');
    $prefix = (string)($argv[3] ?? '');
    $host   = strtolower((string)($argv[4] ?? ''));
    if ($prefix === '-') $prefix = '';
    if (!preg_match('/^[A-Za-z0-9_\-]{1,64}$/', $db) || !preg_match('/^[A-Za-z0-9_]{0,32}$/', $prefix)
        || ($host !== '' && !preg_match('/^[a-z0-9][a-z0-9.\-]*\.[a-z0-9\-]{2,}$/', $host))) out(['error' => 'Invalid database, prefix or hostname']);
    $q   = fn(string $sql) => trim((string)shell_exec('plesk db -Ne ' . escapeshellarg($sql) . ' 2>/dev/null'));
    putenv('MYSQL_PWD=' . trim((string)@file_get_contents('/etc/psa/.psa.shadow')));
    if (trim((string)shell_exec('mysql -uadmin -N -e ' . escapeshellarg("SHOW DATABASES LIKE '" . str_replace('_', '\\_', $db) . "'") . ' 2>/dev/null')) !== $db) {
        out(['error' => 'Database ' . $db . ' does not exist on the local database server']);
    }
    $row = $q("SELECT COALESCE(NULLIF(d.webspace_id,0), d.id), s.host FROM data_bases b JOIN domains d ON d.id = b.dom_id "
            . "JOIN DatabaseServers s ON s.id = b.db_server_id WHERE b.name = '" . $db . "' AND b.type = 'mysql' LIMIT 1");
    if ($row !== '') {
        [$webspace, $dbhost] = array_pad(preg_split('/\s+/', $row), 2, '');
        if (!in_array($dbhost, ['localhost', '127.0.0.1', '::1', ''], true)) out(['error' => 'Only databases on the local database server can be backed up from here']);
    } else {
        // Not registered in Plesk (created by hand or left over): store the backup with the
        // hosted domain the hostname falls under
        $webspace = '';
        for ($name = $host; $name !== '' && substr_count($name, '.') >= 1; $name = substr($name, strpos($name, '.') + 1)) {
            $webspace = $q("SELECT COALESCE(NULLIF(webspace_id,0), id) FROM domains WHERE name = '" . $name . "' AND htype = 'vrt_hst' LIMIT 1");
            if ($webspace !== '') break;
        }
        if ($webspace === '') out(['error' => 'Could not find the subscription this database belongs to']);
    }
    $user = preg_split('/\s+/', $q("SELECT s.login, s.home FROM hosting h JOIN sys_users s ON s.id = h.sys_user_id WHERE h.dom_id = " . (int)$webspace . " LIMIT 1"));
    [$login, $home] = array_pad($user, 2, '');
    if (!$login || strpos(rtrim($home, '/') . '/', VHOSTS) !== 0 || !is_dir($home)) out(['error' => 'Could not find the subscription folder']);

    putenv('MYSQL_PWD=' . trim((string)@file_get_contents('/etc/psa/.psa.shadow')));
    $tables = [];
    if ($prefix !== '') {
        foreach (explode("\n", trim((string)shell_exec('mysql -uadmin -N -e ' . escapeshellarg('SHOW TABLES FROM `' . $db . '`') . ' 2>/dev/null'))) as $t) {
            if ($t !== '' && strpos($t, $prefix) === 0) $tables[] = $t;
        }
        if (!$tables) out(['error' => 'No tables with prefix ' . $prefix . ' in ' . $db]);
    }
    $private = rtrim($home, '/') . '/private';
    if (!is_dir($private) || is_link($private)) out(['error' => 'The subscription has no private folder']);
    $dir = $private . '/vt-db-backups';
    if (is_link($dir)) out(['error' => 'Unexpected link in the private folder']);
    if (!is_dir($dir)) mkdir($dir, 0700);
    chown($dir, $login); chgrp($dir, 'psacln'); chmod($dir, 0700); // never leave anything root-owned in a vhost
    $file = $dir . '/' . $db . ($prefix !== '' ? '-' . rtrim($prefix, '_') : '') . '-' . date('Ymd-His') . '.sql.gz';
    $cmd  = 'mysqldump -uadmin --single-transaction --quick --no-tablespaces ' . escapeshellarg($db) . ' '
          . implode(' ', array_map('escapeshellarg', $tables)) . ' 2>/dev/null | gzip -9 > ' . escapeshellarg($file)
          . '; echo ${PIPESTATUS[0]}';
    $code = trim((string)shell_exec('bash -c ' . escapeshellarg($cmd)));
    putenv('MYSQL_PWD');
    if (is_file($file)) { chown($file, $login); chgrp($file, 'psacln'); chmod($file, 0600); }
    if ($code !== '0' || !is_file($file) || filesize($file) < 100) { @unlink($file); out(['error' => 'The backup failed']); }
    out(['ok' => true, 'file' => substr($file, strlen(VHOSTS)), 'size' => filesize($file), 'tables' => count($tables)]);
}
// ── Clean (Imunify) and quarantine, one file at a time ─────────
// site-scan fileact <op> <hostname> <relative path>      op: check | diff | clean | restore | quarantine
// site-scan fileact unquarantine <qid>
// site-scan fileact qlist <hostname>
//
// Safety:
//  - The path must stay inside the site's document root (no "..", no symlink, realpath checked).
//  - Quarantine and restore walk the path folder by folder without following any link and refuse
//    hard links (see py_fileop_src), so a link swapped in by the site never makes root touch a file
//    outside the site.
//  - Cleaning is done by Imunify itself, which keeps the original (restore-original = Undo).
//  - Quarantine moves the file to a root-only folder with its original place, mode and time,
//    so Restore puts it back exactly. Nothing is ever deleted for good.
const QDIR = '/var/lib/stingyscan/quarantine'; // root only (0700); never under the panel's data folder

if ($mode === 'fileact') {
    $op = (string)($argv[2] ?? '');
    if ($op === 'unquarantine') fa_out(q_restore((string)($argv[3] ?? '')));
    if ($op === 'qinfo')        out(q_info());
    if ($op === 'qdelete')      out(q_delete((string)($argv[3] ?? '')));
    if ($op === 'qpurge')       out(q_purge(max(1, (int)($argv[3] ?? 0))));  // older than N days
    if ($op === 'qdeleteall')   out(q_purge(0));
    $host = strtolower(trim((string)($argv[3] ?? '')));
    if (!preg_match('/^[a-z0-9][a-z0-9.\-]*\.[a-z0-9\-]{2,}$/', $host)) out(['error' => 'Invalid site name']);
    if ($op === 'qlist') out(['items' => q_list($host)]);
    $site = fa_site($host, (string)($argv[4] ?? ''), $op !== 'restore'); // after a cleanup the file may be gone
    switch ($op) {
        case 'check':      fa_out(imu_check($site));
        case 'diff':       fa_out(imu_diff($site));
        case 'clean':      fa_out(imu_clean($site));
        case 'restore':    fa_out(imu_restore($site));
        case 'quarantine': fa_out(q_add($site, substr(preg_replace('/[^\w.@ -]/u', '', (string)($argv[5] ?? '')), 0, 100)));
    }
    out(['error' => 'Unknown action']);
}

function fa_out(array $a): void { out($a); }


/** Validate a site file: [host, root, rel, path, user]. $mustExist=false for a restore target. */
function fa_site(string $host, string $rel, bool $mustExist = true): array
{
    $root = docroot($host);
    if (!$root) out(['error' => 'Could not find the website folder of ' . $host]);
    $rel = ltrim($rel, '/');
    if ($rel === '' || strlen($rel) > 4000 || strpos($rel, "\0") !== false
        || preg_match('#(^|/)\.\.?(/|$)#', $rel)) out(['error' => 'Invalid file path']);
    $path = $root . '/' . $rel;
    $own  = @fileowner($root);
    $pw   = $own !== false ? posix_getpwuid($own) : null;
    if (!$pw || $own < 500 || $pw['name'] === 'root') out(['error' => 'Could not find the system user of this site']);
    if ($mustExist) {
        if (is_link($path) || !is_file($path)) out(['error' => 'The file no longer exists (or is a link)']);
        $real = realpath($path);
        if (!$real || strpos($real, $root . '/') !== 0) out(['error' => 'The file is outside the website folder']);
    } else {
        $dir = realpath(dirname($path));
        if (!$dir || strpos($dir . '/', $root . '/') !== 0) out(['error' => 'The folder of the file no longer exists in the website']);
    }
    return ['host' => $host, 'root' => $root, 'rel' => $rel, 'path' => $path, 'user' => $pw['name']];
}

// ── Imunify ────────────────────────────────────────────────────

function imu_bin(): string
{
    $s = imunify_detect();
    if (!$s) out(['error' => 'Imunify is not installed on this server']);
    return $s['bin'];
}

/** Imunify's newest entry for this exact file, or null */
function imu_item(array $site): ?array
{
    $best = null;
    foreach (imunify_json(['bin' => imu_bin()], 'malware malicious list --limit 50 --search ' . escapeshellarg($site['path']))['items'] ?? [] as $it) {
        if (($it['file'] ?? '') === $site['path'] && (!$best || $it['id'] > $best['id'])) $best = $it;
    }
    return $best;
}

function imu_view(?array $it): ?array
{
    return $it ? ['id' => (int)$it['id'], 'status' => (string)($it['status'] ?? ''), 'type' => (string)($it['type'] ?? '')] : null;
}

/** Wait until Imunify has no on-demand scan or cleanup running (max $max seconds) */
function imu_wait(string $what, int $max): bool
{
    for ($t = 0; $t < $max; $t += 3) {
        $s = imunify_json(['bin' => imu_bin()], 'malware ' . $what . ' status');
        if (($s['status'] ?? $s['items']['status'] ?? '') !== 'running') return true;
        sleep(3);
    }
    return false;
}

/** Does Imunify see this file as malware? If it has no entry yet, scan just this file first (detection only). */
function imu_check(array $site): array
{
    $it = imu_item($site);
    if (!$it || ($it['status'] ?? '') !== 'found') {
        $name = basename($site['path']);
        if (preg_match('/[*?\[\],]/', $name)) return ['item' => imu_view($it), 'note' => 'Imunify cannot check a file with this name on its own'];
        if (!imu_wait('on-demand', 60)) return ['pending' => true, 'item' => imu_view($it)];
        // On-demand scans only report: Imunify's default action is not applied to them
        shell_exec('timeout 60 ' . escapeshellarg(imu_bin()) . ' malware on-demand start --path ' . escapeshellarg(dirname($site['path']) . '/')
                 . ' --file-mask ' . escapeshellarg($name) . ' >/dev/null 2>&1');
        sleep(2);
        if (!imu_wait('on-demand', 90)) return ['pending' => true, 'item' => imu_view(imu_item($site))];
        $it = imu_item($site);
    }
    return ['item' => imu_view($it)];
}

function imu_diff(array $site): array
{
    $it = imu_item($site);
    if (!$it || $it['status'] !== 'found') return ['error' => 'Imunify has not detected this file (choose Clean again to check it first)'];
    $d = imunify_json(['bin' => imu_bin()], 'malware malicious diff --id ' . (int)$it['id']);
    $diff = base64_decode((string)($d['diff'] ?? ''), true);
    if ($diff === false) $diff = '';
    $lines = substr_count($diff, "\n");
    if (strlen($diff) > 30000) $diff = substr($diff, 0, 30000) . "\n… (shortened)";
    return ['item' => imu_view($it), 'diff' => $diff, 'lines' => $lines, 'size' => (int)@filesize($site['path'])];
}

function imu_clean(array $site): array
{
    $it = imu_item($site);
    if (!$it || $it['status'] !== 'found') return ['error' => 'Imunify has not detected this file, so it cannot clean it. Use Quarantine instead.'];
    if (!imu_wait('cleanup', 60)) return ['error' => 'Imunify is busy cleaning other files; try again in a minute'];
    shell_exec('timeout 120 ' . escapeshellarg(imu_bin()) . ' malware malicious cleanup ' . (int)$it['id'] . ' >/dev/null 2>&1');
    sleep(2);
    imu_wait('cleanup', 120);
    $after = imunify_json(['bin' => imu_bin()], 'malware malicious list --ids ' . (int)$it['id'])['items'][0] ?? null;
    $st = (string)($after['status'] ?? '');
    clearstatcache();
    if (strpos($st, 'cleanup_done') !== 0 && strpos($st, 'cleanup_removed') !== 0) {
        return ['error' => 'Imunify did not clean the file' . ($st ? ' (' . $st . ')' : ''), 'item' => imu_view($after)];
    }
    return ['ok' => true, 'item' => imu_view($after), 'status' => $st, 'size' => is_file($site['path']) ? (int)filesize($site['path']) : null];
}

function imu_restore(array $site): array
{
    $site2 = $site;
    $userArg = (is_file($site2['path']) && (posix_getpwuid((int)fileowner($site2['path']))['name'] ?? '') === $site2['user'])
        ? ' --user ' . escapeshellarg($site2['user']) : '';
    $r = imunify_json(['bin' => imu_bin()], 'malware malicious restore-original --path ' . escapeshellarg($site2['path']) . $userArg);
    if (in_array($site2['path'], $r['succeeded'] ?? [], true)) return ['ok' => true, 'item' => imu_view(imu_item($site2))];
    return ['error' => 'Imunify could not restore the original' . (($r['not_exist'] ?? []) ? ': no original kept for this file' : '')];
}

// ── Quarantine ─────────────────────────────────────────────────
// Root moves the file, so it works whoever owns it (the site user, apache, root). To make that safe
// against a site that swaps in symbolic links, a small Python helper does the file work with
// directory file descriptors: it walks from /var/www/vhosts one folder at a time without following
// any link (O_NOFOLLOW), opens the file without following a link, refuses hard links, copies it,
// and deletes exactly the file it copied (same inode). Restore creates the file only if nothing is
// there (O_EXCL), again without following links, with the original owner, permissions and date.

function py_fileop_src(): string
{
    return <<<'PY'
import errno, json, os, stat, sys

def walk(base, parts):
    fd = os.open(base, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    for p in parts:
        if p in ('', '.', '..'):
            raise ValueError('Invalid file path')
        nfd = os.open(p, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
        os.close(fd)
        fd = nfd
    return fd

def copy(r, w):
    while True:
        b = r.read(1 << 20)
        if not b:
            break
        w.write(b)

def main():
    op, base, rel = sys.argv[1], sys.argv[2], sys.argv[3]
    parts = rel.split('/')
    name = parts[-1]
    if name in ('', '.', '..'):
        raise ValueError('Invalid file path')
    pfd = walk(base, parts[:-1])
    if op == 'take':
        out = sys.argv[4]
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=pfd)
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise ValueError('This is not a regular file')
        if st.st_nlink > 1:
            raise ValueError('The file has other hard links, so it was not moved')
        with os.fdopen(fd, 'rb') as r, os.fdopen(os.open(out, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), 'wb') as w:
            copy(r, w)
        now = os.stat(name, dir_fd=pfd, follow_symlinks=False)
        if (now.st_ino, now.st_dev) != (st.st_ino, st.st_dev) or os.path.getsize(out) != st.st_size:
            os.unlink(out)
            raise ValueError('The file changed while it was being moved, so nothing was changed')
        os.unlink(name, dir_fd=pfd)
        print(json.dumps({'ok': True, 'uid': st.st_uid, 'gid': st.st_gid, 'mode': '%04o' % stat.S_IMODE(st.st_mode),
                          'mtime': int(st.st_mtime), 'size': st.st_size}))
    elif op == 'put':
        src, uid, gid, mode, mtime = sys.argv[4], int(sys.argv[5]), int(sys.argv[6]), int(sys.argv[7], 8), int(sys.argv[8])
        fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=pfd)
        with open(src, 'rb') as r, os.fdopen(fd, 'wb') as w:
            copy(r, w)
            w.flush()
            os.fchown(w.fileno(), uid, gid)
            os.fchmod(w.fileno(), mode)
            os.utime(w.fileno(), (mtime, mtime))
        print(json.dumps({'ok': True}))
    else:
        raise ValueError('Unknown operation')

try:
    main()
except FileExistsError:
    print(json.dumps({'error': 'There is a file at this place again. Rename or remove it first, then restore.'}))
except FileNotFoundError:
    print(json.dumps({'error': 'The file or one of its folders no longer exists'}))
except OSError as e:
    if e.errno in (errno.ELOOP, errno.ENOTDIR, errno.EMLINK):
        print(json.dumps({'error': 'A link was found in the path, so nothing was changed'}))
    else:
        print(json.dumps({'error': e.strerror or str(e)}))
except Exception as e:
    print(json.dumps({'error': str(e)}))
PY;
}

/** Run the helper: take <base> <rel> <out> | put <base> <rel> <src> <uid> <gid> <mode> <mtime> */
function py_fileop(array $args): array
{
    $py = bin_path('python3');
    if (!$py) return ['error' => 'python3 is needed for the quarantine and is not installed'];
    $out = (string)shell_exec(escapeshellarg($py) . ' -I -c ' . escapeshellarg(py_fileop_src()) . ' '
                            . implode(' ', array_map('escapeshellarg', $args)) . ' 2>&1');
    $lines = array_values(array_filter(array_map('trim', explode("\n", $out))));
    $d = json_decode((string)end($lines), true);
    return is_array($d) ? $d : ['error' => 'The quarantine helper failed: ' . substr($out, 0, 300)];
}

/** Path of a site file relative to /var/www/vhosts, for the helper */
function vh_rel(string $path): string
{
    return substr($path, strlen(VHOSTS));
}

function q_add(array $site, string $by = ''): array
{
    if (!is_dir(QDIR)) { @mkdir(QDIR, 0700, true); @chmod(dirname(QDIR), 0700); }
    $qid = date('Ymd-His') . '-' . bin2hex(random_bytes(4));
    $dir = QDIR . '/' . $qid;
    if (!@mkdir($dir, 0700)) return ['error' => 'Could not create the quarantine folder'];
    $copy = $dir . '/file';
    $r = py_fileop(['take', rtrim(VHOSTS, '/'), vh_rel($site['path']), $copy]);
    if (empty($r['ok'])) { @unlink($copy); @rmdir($dir); return ['error' => $r['error'] ?? 'The file could not be moved']; }
    $meta = [
        'qid' => $qid, 'domain' => $site['host'], 'rel' => $site['rel'], 'path' => $site['path'], 'user' => $site['user'],
        'owner' => posix_getpwuid((int)$r['uid'])['name'] ?? (string)$r['uid'], 'uid' => (int)$r['uid'], 'gid' => (int)$r['gid'],
        'mode' => (string)$r['mode'], 'mtime' => (int)$r['mtime'], 'size' => (int)$r['size'],
        'sha256' => hash_file('sha256', $copy), 'at' => time(), 'by' => $by,
    ];
    file_put_contents($dir . '/meta.json', json_encode($meta, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
    chmod($dir . '/meta.json', 0600);
    return ['ok' => true, 'qid' => $qid, 'item' => array_diff_key($meta, ['path' => 1])];
}

function q_meta(string $qid): ?array
{
    if (!preg_match('/^\d{8}-\d{6}-[0-9a-f]{8}$/', $qid)) return null;
    $m = json_decode((string)@file_get_contents(QDIR . '/' . $qid . '/meta.json'), true);
    return is_array($m) && is_file(QDIR . '/' . $qid . '/file') ? $m : null;
}

function q_list(string $host): array
{
    $out = [];
    foreach (glob(QDIR . '/*/meta.json') ?: [] as $f) {
        $m = q_meta(basename(dirname($f)));
        if ($m && $m['domain'] === $host) $out[] = array_diff_key($m, ['path' => 1]);
    }
    usort($out, fn($a, $b) => $b['at'] <=> $a['at']);
    return $out;
}

/** Number and total size of the quarantined files */
function q_info(): array
{
    $n = 0; $bytes = 0; $oldest = 0;
    foreach (glob(QDIR . '/*/meta.json') ?: [] as $f) {
        $m = q_meta(basename(dirname($f)));
        if (!$m) continue;
        $n++; $bytes += (int)@filesize(QDIR . '/' . $m['qid'] . '/file');
        $oldest = $oldest ? min($oldest, (int)$m['at']) : (int)$m['at'];
    }
    return ['count' => $n, 'bytes' => $bytes, 'oldest' => $oldest, 'dir' => QDIR];
}

/** Delete one quarantined file for good */
function q_delete(string $qid): array
{
    $m = q_meta($qid);
    if (!$m) return ['error' => 'This file is no longer in quarantine'];
    $dir = QDIR . '/' . $qid;
    @unlink($dir . '/file'); @unlink($dir . '/meta.json'); @rmdir($dir);
    return is_dir($dir) ? ['error' => 'Could not delete the quarantined file']
                        : ['ok' => true, 'qid' => $qid, 'domain' => $m['domain'], 'rel' => $m['rel']];
}

/** Delete quarantined files older than $days days (0 = all of them) */
function q_purge(int $days): array
{
    $cut = $days > 0 ? time() - $days * 86400 : PHP_INT_MAX;
    $deleted = [];
    foreach (glob(QDIR . '/*/meta.json') ?: [] as $f) {
        $m = q_meta(basename(dirname($f)));
        if (!$m || (int)$m['at'] >= $cut) continue;
        $r = q_delete($m['qid']);
        if (!empty($r['ok'])) $deleted[] = ['qid' => $m['qid'], 'domain' => $m['domain'], 'rel' => $m['rel']];
    }
    return ['ok' => true, 'deleted' => $deleted] + q_info();
}

function q_restore(string $qid): array
{
    $m = q_meta($qid);
    if (!$m) return ['error' => 'This file is no longer in quarantine'];
    $site = fa_site($m['domain'], $m['rel'], false);
    $copy = QDIR . '/' . $qid . '/file';
    if (hash_file('sha256', $copy) !== $m['sha256']) return ['error' => 'The quarantined copy has changed; not restored'];
    // Original owner; quarantines made before 2.2.1 have no uid/gid: the site user then
    $uid = isset($m['uid']) ? (int)$m['uid'] : (int)(posix_getpwnam($m['owner'])['uid'] ?? posix_getpwnam($site['user'])['uid']);
    $gid = isset($m['gid']) ? (int)$m['gid'] : (int)(posix_getgrnam('psacln')['gid'] ?? 0);
    $mode = preg_match('/^0?[0-7]{3,4}$/', (string)$m['mode']) ? (string)$m['mode'] : '0644';
    $r = py_fileop(['put', rtrim(VHOSTS, '/'), vh_rel($site['path']), $copy, (string)$uid, (string)$gid, $mode, (string)(int)$m['mtime']]);
    if (empty($r['ok'])) return ['error' => str_replace('this place', $m['rel'], $r['error'] ?? 'Could not write the file back')];
    @unlink($copy); @unlink(QDIR . '/' . $qid . '/meta.json'); @rmdir(QDIR . '/' . $qid);
    return ['ok' => true, 'qid' => $qid, 'domain' => $m['domain'], 'rel' => $m['rel'], 'note' => ''];
}

if ($mode !== 'start' && $mode !== '--run') out(['error' => 'usage: site-scan list | wpconfigs | dump <db> [prefix] | start <scanner> <hostname> | fileact <op> <hostname> <file>']);

$id   = (string)($argv[2] ?? '');
$host = strtolower(trim((string)($argv[3] ?? '')));
if (!in_array($id, SCANNERS, true)) out(['error' => 'Unknown scanner']);
if (!preg_match('/^[a-z0-9][a-z0-9.\-]*\.[a-z0-9\-]{2,}$/', $host)) out(['error' => 'Invalid site name']);
$all     = scanners();
$scanner = $all[$id] ?? null;
if (!$scanner) out(['error' => $id . ' is not installed on this server']);

$resultFile = DATA . '/vt_scan_' . $id . '_' . preg_replace('/[^a-z0-9]/', '_', $host) . '.json';
$lockFile   = DATA . '/vt_scan.lock';
$base       = ['domain' => $host, 'scanner' => $id, 'name' => $scanner['name']];

// One scan engine only: with ClamAV installed, Maldet never runs (ClamAV already uses Maldet's signatures)
if ($id === 'maldet' && isset($all['clamav'])) {
    $msg = 'Maldet is not used while ClamAV is installed: the ClamAV scan includes the Maldet signatures';
    if ($mode === '--run') { save($resultFile, $base + ['status' => 'error', 'finished' => time(), 'message' => $msg]); exit(0); }
    out(['error' => $msg]);
}

if ($mode === 'start') {
    $prev = json_decode((string)@file_get_contents($resultFile), true);
    if (in_array($prev['status'] ?? '', ['running', 'queued'], true) && time() - (int)($prev['started'] ?? 0) < TIMEOUT + 600) {
        out(['started' => true, 'already' => true] + $base);
    }
    $root = docroot($host);
    if (!$root) out(['error' => 'Could not find the website folder of ' . $host]);

    $lock = fopen($lockFile, 'c');
    $free = $lock && flock($lock, LOCK_EX | LOCK_NB);
    if ($free) flock($lock, LOCK_UN);
    if ($lock) fclose($lock);
    save($resultFile, $base + ['status' => $free ? 'running' : 'queued', 'started' => time(), 'root' => substr($root, strlen(VHOSTS))]);
    exec('setsid nohup ' . escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg(__FILE__)
         . ' --run ' . escapeshellarg($id) . ' ' . escapeshellarg($host) . ' >/dev/null 2>&1 &');
    out(['started' => true] + $base);
}

// --run: wait for any other scan to finish (one at a time on the server)
$lock = fopen($lockFile, 'c');
if (!$lock || !flock($lock, LOCK_EX)) {
    save($resultFile, $base + ['status' => 'error', 'finished' => time(), 'message' => 'Could not start the scan']);
    exit(0);
}
ftruncate($lock, 0); fwrite($lock, "$id $host"); fflush($lock);

// Rate limit actual work, including read-only Imunify result requests, across all users.
require_once '/usr/local/psa/admin/plib/modules/stingyscan/library/VtCheckRateLimiter.php';
try {
    while ($wait = VtCheckRateLimiter::reserve($id)) {
        save($resultFile, $base + ['status' => 'queued', 'started' => time(), 'message' => 'Waiting for request rate limit']);
        sleep($wait);
    }
} catch (\Throwable $e) {
    save($resultFile, $base + ['status' => 'error', 'finished' => time(), 'message' => 'Request rate limiter unavailable']);
    exit(1);
}

$started = time();
$root    = docroot($host);
if (!$root) {
    save($resultFile, $base + ['status' => 'error', 'finished' => time(), 'message' => 'Website folder not found']);
    exit(0);
}
save($resultFile, $base + ['status' => 'running', 'started' => $started, 'root' => substr($root, strlen(VHOSTS))]);

// Progress for the page: written at most every 2 seconds
$GLOBALS['on_progress'] = function (int $done, int $total, string $phase) use ($resultFile, $base, $started, $root) {
    static $last = 0;
    if (microtime(true) - $last < 2 && $done < $total) return;
    $last = microtime(true);
    save($resultFile, $base + ['status' => 'running', 'started' => $started, 'root' => substr($root, strlen(VHOSTS)),
                               'done' => $done, 'total' => $total, 'phase' => $phase]);
};

save($resultFile, finish($base, $id, $scanner, $root, $started));
ftruncate($lock, 0);
flock($lock, LOCK_UN);
